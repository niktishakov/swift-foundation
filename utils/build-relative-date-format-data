# Builds the relative-date-format Swift data (RelativeDateFormatData.swift) for the
# _FoundationInternationalizationData library from RelativeDateFormatData.json.
# The data is used when FOUNDATION_RELATIVE_DATE_FORMAT_SWIFT is set.
#
# Usage:
#   build-relative-date-format-data [--locales=en,es,...] [--fallback=en] \
#                           [--input=path/to/RelativeDateFormatData.json] \
#                           [--output=path/to/RelativeDateFormatData.swift]
#
# --locales: comma-separated subset of locales to include (default: all).
# --fallback: locale whose data a lookup uses when the identifier's language
#             has no data; included in the data (default: root).
# --input: path to the JSON intermediate (default: in the source tree).
# --output: path to the generated Swift file (default: in the source tree).

set -eu

declare -r commandName="$(basename "$0")"
declare -r utilsDir="$(cd "$(dirname "$0")" && pwd)"
declare -r foundationRepoDir="$(cd "${utilsDir}/.." && pwd)"
declare -r inputDefault="${foundationRepoDir}/Sources/FoundationInternationalization/Formatting/RelativeDateFormatData.json"
declare -r outputSwiftDefault="${foundationRepoDir}/Sources/_FoundationInternationalizationData/RelativeDateFormatData.swift"

INPUT="${INPUT:-${inputDefault}}"
OUTPUT_SWIFT="${OUTPUT_SWIFT:-${outputSwiftDefault}}"
LOCALES="${LOCALES:-}"
FALLBACK="${FALLBACK:-root}"

for arg in "$@"; do
  case "$arg" in
    --locales=*)       LOCALES="${arg#--locales=}" ;;
    --fallback=*)      FALLBACK="${arg#--fallback=}" ;;
    --input=*)         INPUT="${arg#--input=}" ;;
    --output=*)        OUTPUT_SWIFT="${arg#--output=}" ;;
    --help|-h)
      echo "Usage: ${commandName} [--locales=en,es,...] [--fallback=en] [--input=path] [--output=path]" 1>&2
      exit 0
      ;;
    *)
      echo "error: unknown argument: ${arg}" 1>&2
      echo "Try --help." 1>&2
      exit 1
      ;;
  esac
done

if [[ ! -f "${INPUT}" ]]; then
  echo "error: input JSON not found at ${INPUT}" 1>&2
  echo "Run utils/update-relative-date-format-data first to generate it from CLDR." 1>&2
  exit 1
fi

echo "Building relative-date-format data" 1>&2
echo "  from:     ${INPUT}" 1>&2
echo "  output:   ${OUTPUT_SWIFT}" 1>&2
echo "  locales:  ${LOCALES:-all}" 1>&2
echo "  fallback: ${FALLBACK}" 1>&2

# Build the schema and the impl as one module, then run it. `-parse-as-library`
# lets the impl's `@main` provide the entry point.
bindir=$(mktemp -d -t "${commandName}.XXXXXX")
trap 'rm -rf "${bindir}"' EXIT
tool="${bindir}/${commandName}"
swiftc -parse-as-library \
    "${utilsDir}/relative-date-format-data-schema.swift" \
    "${utilsDir}/${commandName}-impl.swift" \
    -o "${tool}"

env LOCALES="${LOCALES}" FALLBACK="${FALLBACK}" INPUT="${INPUT}" OUTPUT_SWIFT="${OUTPUT_SWIFT}" \
  "${tool}"

echo "Done." 1>&2
